# Secrets
.env
*.env
integration_tests/.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

# Generated outputs
# Run outputs are regenerable and stay out of git -- except results/paper/,
# which holds the per-seed data behind the published tables. The paper's
# Availability statement promises that data is here, and a bare "results/"
# rule is exactly why it was not: git does not descend into an ignored
# directory, so the exception has to be made at this level.
results/*
!results/paper/
*.mp4
*.png
*.pptx

# IDE / OS
.DS_Store
.vscode/
*.swp

# Python cache
__pycache__/
*.pyc
*.pyo

# Tool cache files
tools/osm_cache.json
tools/vlm_calibration/
.DS_Store
